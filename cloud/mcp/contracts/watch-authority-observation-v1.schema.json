{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poyi.invalid/contracts/watch-authority-observation-v1.schema.json",
  "title": "Watch service-binding authority observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "productId", "audience", "observedAt", "expiresAt", "truth"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "productId": { "const": "watch" },
    "audience": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/?#]+/authority/watch$"
    },
    "observedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision", "freshness", "lastVerifiedAt", "pendingCount", "blockerReason", "pcOff"
      ],
      "properties": {
        "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "freshness": { "enum": ["fresh", "stale", "offline", "blocked", "unknown"] },
        "lastVerifiedAt": { "type": "string", "format": "date-time" },
        "pendingCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "blockerReason": {
          "oneOf": [
            {
              "enum": [
                "invalid_device_checkpoint",
                "no_active_device",
                "read_projection_not_materialized",
                "read_projection_catchup_pending",
                "incomplete_server_operation",
                "device_catchup_pending",
                "write_not_verified",
                "continued_sync_unverified"
              ]
            },
            { "type": "null" }
          ]
        },
        "pcOff": {
          "type": "object",
          "additionalProperties": false,
          "required": ["readAvailable", "writeAvailable", "continuedSync"],
          "properties": {
            "readAvailable": { "type": "boolean" },
            "writeAvailable": { "type": "boolean" },
            "continuedSync": { "type": "boolean" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "freshness": { "const": "fresh" } }, "required": ["freshness"] },
          "then": {
            "properties": {
              "pendingCount": { "const": 0 },
              "blockerReason": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "pendingCount": { "minimum": 1 } }, "required": ["pendingCount"] },
          "then": { "properties": { "freshness": { "const": "blocked" } } }
        },
        {
          "if": {
            "properties": { "pcOff": { "properties": { "continuedSync": { "const": true } } } },
            "required": ["pcOff"]
          },
          "then": {
            "properties": {
              "pcOff": {
                "properties": {
                  "readAvailable": { "const": true },
                  "writeAvailable": { "const": true }
                }
              }
            }
          }
        }
      ]
    }
  }
}
